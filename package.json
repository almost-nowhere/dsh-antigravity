{
  "name": "dsh-antigravity",
  "version": "0.0.9",
  "description": "Google Antigravity / Cloud Code Assist model provider for DeepSeek Harness with multi-account pool and quota scheduling",
  "author": "零测集",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "QUOTA-SCHEDULING.md",
    "LICENSE",
    "assets"
  ],
  "bin": {
    "antigravity-login": "bin/antigravity-login.mjs"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/diagnostics.js && node --check lib/client.js && node --check lib/account-scheduler.js && node --check lib/account-pool.js && node --check lib/pool-health.js && node --check lib/runtime-status.js && node --check bin/antigravity-login.mjs",
    "pack:dist": "mkdir -p dist && npm pack --pack-destination dist"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "antigravity",
    "google",
    "cloud-code-assist",
    "oauth",
    "llm",
    "adapter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almost-nowhere/dsh-antigravity.git"
  },
  "homepage": "https://github.com/almost-nowhere/dsh-antigravity#readme",
  "bugs": {
    "url": "https://github.com/almost-nowhere/dsh-antigravity/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-timeout": "*"
  },
  "peerDependenciesMeta": {
    "*": {
      "optional": true
    }
  }
}
